public static Node deleteKthNode(Node head, int k){
if (head == null) return null;

if (k == 1) return head.next;

Node temp = head;

for (int i = 1; i < k - 1 && temp != null; i++) {
temp = temp.next;
}

if (temp == null || temp.next == null) {
return head;
}

temp.next = temp.next.next;

return head;
}